# ─────────────────────────────────────────────────────────────
# Speak Rooms — multi-model cascade (optional)
# Learner never sees these. First working slot wins; rest are fallbacks.
# Leave all blank → pure offline swarm (always works).
# ─────────────────────────────────────────────────────────────

# Primary (e.g. Groq free tier)
# VITE_SPEAK_LLM_URL=https://api.groq.com/openai/v1
# VITE_SPEAK_LLM_MODEL=llama-3.1-8b-instant
# VITE_SPEAK_LLM_KEY=gsk_...

# Secondary (e.g. OpenRouter)
# VITE_SPEAK_LLM_2_URL=https://openrouter.ai/api/v1
# VITE_SPEAK_LLM_2_MODEL=meta-llama/llama-3.1-8b-instruct:free
# VITE_SPEAK_LLM_2_KEY=sk-or-...

# Tertiary (e.g. OpenAI)
# VITE_SPEAK_LLM_3_URL=https://api.openai.com/v1
# VITE_SPEAK_LLM_3_MODEL=gpt-4o-mini
# VITE_SPEAK_LLM_3_KEY=sk-...

# Generic OpenAI-compatible fallback (used only if primary unset)
# VITE_OPENAI_BASE_URL=http://localhost:11434/v1
# VITE_OPENAI_MODEL=llama3.1
# VITE_OPENAI_API_KEY=

# Local Ollama example:
# VITE_SPEAK_LLM_URL=http://localhost:11434/v1
# VITE_SPEAK_LLM_MODEL=llama3.1
