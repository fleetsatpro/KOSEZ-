# Copy to .env and fill in. Grouped by what actually reads each var
# (verified against every process.env.* / env("...") call in src/, server/, scripts/).

# ---- Database (required) ----
# Neon/Supabase Postgres connection string.
DATABASE_URL=

# ---- Auth: Better Auth (required if VITE_AUTH_ENABLED=true) ----
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Comma-separated emails granted admin on first boot.
ADMIN_BOOTSTRAP_EMAILS=

# Toggle auth on/off. Build-time-inlined — always invoke via npm run dev
# / npm run build (see scripts/with-app-env.mjs), never a bare vite dev,
# or dev/build can silently disagree (see scripts/check-auth-invariant.mjs).
VITE_AUTH_ENABLED=true

# ---- Grok platform integration (App Builder auth broker / preview host) ----
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=
GROK_GATE_ORIGIN=
GROK_PROJECT_ID=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=
# Only used by the preview host bridge; unset in normal local dev.
GROK_PREVIEW_CLIENT_SECRET=

# ---- Speech-to-text (optional — without these, capture-only mode: no
# transcript, no phonetic score; see docs/speech.md) ----
SPEAK_STT_API_KEY=
SPEAK_STT_URL=
SPEAK_STT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Fallback provider.
GROQ_API_KEY=
GROQ_STT_MODEL=
GROQ_MODEL=

# ---- Speak LLM (roleplay / OSEZ conversation partner) ----
SPEAK_LLM_API_KEY=
SPEAK_LLM_URL=
SPEAK_LLM_MODEL=
SPEAK_LLM_REFERER=
SPEAK_LLM_TITLE=
# Alternative provider path.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- Public / client-visible ----
VITE_PUBLIC_HOSTNAME=

# ---- Browser smoke tests (CI/local verification only) ----
BROWSER_ALLOW_EXTERNAL_HOST=
BROWSER_SMOKE_EXPECT_AUTH=
BROWSER_SMOKE_TIMEOUT_MS=
PREVIEW_READY_TIMEOUT_MS=
PREVIEW_THUMBNAIL_TIMEOUT_MS=

# ---- Set automatically by the platform — do not set locally ----
# NODE_ENV, VERCEL, VERCEL_ENV, GITHUB_WORKSPACE
